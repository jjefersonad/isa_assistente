# Copy to .env (ignored by git).

# Board (firmware) -> PC addresses. ./gen_config.py writes firmware/config.json from these.
# Use this PC's LAN IP (`ip -4 addr`); the ESP32 must reach it.
AGENT_URL=http://192.168.1.100:8765    # server/ (WebSocket agent)
SPEECH_URL=http://192.168.1.100:8800   # api/ (STT + TTS); its port must match SPEECH_PORT below
# WIFI_SSID=                # optional: only needed if there is no firmware/config.json yet
# WIFI_PASSWORD=

APP_UID=1000               # output of `id -u`
APP_GID=1000               # output of `id -g`
SPEECH_PORT=8800           # Docker host port for api/; keep it equal to SPEECH_URL's port
# Piper TTS voice inside the container (./api/models is mounted at /models/piper).
# pt_BR-sage_13364-medium.onnx is a female voice; pt_BR-faber-medium.onnx ships as the default.
PIPER_VOICE=/models/piper/pt_BR-sage_13364-medium.onnx
# HF_CACHE=/home/you/.cache/huggingface   # reuse an existing faster-whisper download


# ElevenLabs TTS. With key + voice id set, /tts uses it by default (TTS_BACKEND=auto: eleven > clone > piper).
# Characters count against your ElevenLabs plan. The key is a secret: put it only in .env, never in git or chat.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=        # a voice id from your ElevenLabs "My Voices"
# ELEVENLABS_MODEL=eleven_multilingual_v2
# TTS_BACKEND=auto            # auto (eleven > supertonic > piper, the first that works) | eleven | supertonic | piper
# ELEVENLABS_COOLDOWN_S=600   # after 401/402/429 (no credits) ElevenLabs is skipped this long

# Supertonic 3: local voice (ONNX), the fallback when ElevenLabs is out of credits. ~390 MB downloaded on first start.
# SUPERTONIC_VOICE=F1         # F1-F5 female, M1-M5 male; empty = disabled
# SUPERTONIC_SPEED=1.05
# SUPERTONIC_STEPS=8          # 5 is ~30% faster on CPU, slightly lower quality
# SUPERTONIC_CACHE=/home/you/.cache/supertonic3

# Whisper and Supertonic run on the GPU when there is one, else on the CPU. GPU image:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build
# DEVICE=auto                 # auto | cpu | cuda
# API_MEM_LIMIT=4g            # the container is killed (not the machine) if it goes over

# Container time zone (logs and anything that reads the clock). The agent's date/time tool uses TIMEZONE (server/.env).
# TZ=America/Sao_Paulo
